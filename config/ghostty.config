# Portable appearance and explicit shell.
command = /bin/zsh --login
font-size = 14
window-padding-x = 12
window-padding-y = 10
macos-option-as-alt = true

# Show/hide all Ghostty windows from any app with Shift-Cmd-~.
# Global keybinds need Ghostty enabled under Privacy & Security > Accessibility.
keybind = global:cmd+shift+backquote=toggle_visibility
